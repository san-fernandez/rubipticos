<%# Botón de tema claro/oscuro (controlador Stimulus "theme"). %>
<button type="button" class="btn btn-sm btn-outline-light ms-md-2" data-controller="theme"
        data-action="theme#toggle" aria-label="Cambiar entre tema claro y oscuro" title="Tema claro u oscuro">
  <i class="bi bi-moon-stars" data-theme-target="icon" aria-hidden="true"></i>
</button>

<%# Reinicio de la tabla de posiciones: guarda Setting#leaderboard_reset_at, no borra partidas. %>
<div class="card mb-3">
  <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
      <h2 class="h6 mb-1">Tabla de posiciones</h2>
      <p class="small text-body-secondary mb-0">
        <% if reset_at %>
          Último reinicio: <%= l(reset_at, format: :long) %>. Solo cuentan las partidas resueltas desde entonces.
        <% else %>
          Nunca se reinició: cuentan todas las partidas.
        <% end %>
      </p>
    </div>
    <%= button_to "Reiniciar tabla de posiciones", reset_leaderboard_admin_players_path,
                  class: "btn btn-sm btn-outline-danger",
                  form: { data: { turbo_confirm: "¿Reiniciar la tabla? Los puntos vuelven a contar desde ahora. Las partidas no se borran." } } %>
  </div>
</div>

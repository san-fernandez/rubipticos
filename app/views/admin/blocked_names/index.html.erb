<% content_for :title, "Términos bloqueados" %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="h3 mb-0">Términos bloqueados</h1>
  <%= link_to "Jugadores", admin_players_path, class: "btn btn-outline-primary btn-sm" %>
</div>

<p class="text-body-secondary">
  Un jugador no puede elegir un nombre que <strong>contenga</strong> alguno de estos términos, sin importar mayúsculas.
  Los nombres que ya existen no cambian: para eso, bloqueá al jugador.
</p>

<%= render "admin/shared/form_errors", record: @blocked_name %>

<%= form_with model: [ :admin, @blocked_name ], class: "row g-2 align-items-end mb-4" do |form| %>
  <div class="col-12 col-sm">
    <%= form.label :term, "Nuevo término", class: "form-label small" %>
    <%= form.text_field :term, required: true, class: "form-control form-control-sm" %>
  </div>
  <div class="col-12 col-sm-auto">
    <%= form.submit "Bloquear término", class: "btn btn-primary btn-sm" %>
  </div>
<% end %>

<% if @blocked_names.any? %>
  <ul class="list-group">
    <% @blocked_names.each do |blocked_name| %>
      <li id="<%= dom_id(blocked_name) %>" class="list-group-item d-flex justify-content-between align-items-center">
        <span><%= blocked_name.term %></span>
        <%= button_to "Quitar", admin_blocked_name_path(blocked_name), method: :delete,
                      class: "btn btn-sm btn-outline-danger",
                      form: { data: { turbo_confirm: "¿Quitar «#{blocked_name.term}»? Se va a poder volver a usar en los nombres." } } %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-body-secondary">Todavía no hay términos bloqueados.</p>
<% end %>

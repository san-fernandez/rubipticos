<%= render "admin/shared/form_errors", record: user %>

<%= form_with model: [ :admin, user ] do |form| %>
  <div class="mb-3">
    <%= form.label :email_address, class: "form-label" %>
    <%= form.email_field :email_address, required: true, autocomplete: "off", class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :role, class: "form-label" %>
    <%= form.select :role, role_options, {}, class: "form-select" %>
    <div class="form-text">El editor de puntajes solo ve los puntos por tipo y los multiplicadores.</div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-12 col-md-6">
      <%= form.label :password, class: "form-label" %>
      <%= form.password_field :password, required: user.new_record?, autocomplete: "new-password", maxlength: 72,
                              class: "form-control" %>
      <% if user.persisted? %>
        <div class="form-text">Dejala en blanco para no cambiarla.</div>
      <% end %>
    </div>
    <div class="col-12 col-md-6">
      <%= form.label :password_confirmation, class: "form-label" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72, class: "form-control" %>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit user.new_record? ? "Crear usuario" : "Guardar cambios", class: "btn btn-primary" %>
    <%= link_to "Cancelar", admin_users_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

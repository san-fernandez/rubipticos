<%# Activa o desactiva un usuario (update de active). Desactivar cierra sus sesiones. %>
<%= button_to user.active? ? "Desactivar" : "Activar",
              admin_user_path(user),
              method: :patch,
              params: { user: { active: !user.active? } },
              class: "btn btn-sm #{user.active? ? "btn-outline-danger" : "btn-outline-success"}",
              form: { data: { turbo_confirm: user.active? ? "¿Desactivar a #{user.email_address}? Se cierran sus sesiones." : nil } } %>

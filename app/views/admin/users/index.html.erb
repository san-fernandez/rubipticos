<% content_for :title, "Usuarios" %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="h3 mb-0">Usuarios del backend</h1>
  <%= link_to "Nuevo usuario", new_admin_user_path, class: "btn btn-primary btn-sm" %>
</div>

<div class="table-responsive">
  <table class="table table-sm table-hover align-middle">
    <thead>
      <tr>
        <th>Email</th>
        <th>Rol</th>
        <th>Estado</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr id="<%= dom_id(user) %>">
          <td>
            <%= user.email_address %>
            <% if user == Current.user %><span class="badge text-bg-secondary ms-1">Vos</span><% end %>
          </td>
          <td><%= role_name(user.role) %></td>
          <td>
            <span class="badge <%= user.active? ? "text-bg-success" : "text-bg-secondary" %>">
              <%= user.active? ? "Activo" : "Desactivado" %>
            </span>
          </td>
          <td>
            <div class="d-flex gap-2 justify-content-end">
              <%= link_to "Editar", edit_admin_user_path(user), class: "btn btn-sm btn-outline-primary" %>
              <%= render "active_toggle", user: %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "admin/shared/pagination", records: @users %>

<%# Errores de un formulario del admin. record: el modelo que no se pudo guardar. %>
<% if record.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <p class="mb-1 fw-semibold">No se pudo guardar:</p>
    <ul class="mb-0">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

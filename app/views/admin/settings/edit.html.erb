<% content_for :title, "Configuración" %>

<div class="col-12 col-lg-8">
  <h1 class="h3 mb-3">Configuración general</h1>

  <%= render "admin/shared/form_errors", record: @setting %>

  <%= form_with model: @setting, url: admin_setting_path do |form| %>
    <div class="mb-3">
      <%= form.label :source_url, class: "form-label" %>
      <%= form.url_field :source_url, required: true, class: "form-control" %>
      <div class="form-text">
        La usa la sincronización del catálogo. Puede ser la API de la cátedra, un fork en GitHub Pages
        o un servidor local, por ejemplo <code>http://localhost:8000/v1/cryptics.json</code>.
      </div>
    </div>

    <div class="mb-3">
      <%= form.label :welcome_text, class: "form-label" %>
      <%= form.text_area :welcome_text, rows: 3, class: "form-control" %>
      <div class="form-text">Se muestra en la página de inicio.</div>
    </div>

    <%= form.submit "Guardar", class: "btn btn-primary" %>
  <% end %>

  <dl class="row small text-body-secondary mt-4 mb-0">
    <dt class="col-sm-5">Última versión sincronizada</dt>
    <dd class="col-sm-7"><%= @setting.last_synced_version.presence || "—" %></dd>
  </dl>
</div>

<% content_for :title, "Cómo se juega" %>

<div class="col-12 col-lg-10 mx-auto">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Cómo se juega</h1>
    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="offcanvas" data-bs-target="#chatbot-panel">
      <i class="bi bi-chat-dots" aria-hidden="true"></i> Preguntale al ayudante
    </button>
  </div>

  <% @sections.each do |node| %>
    <section class="mb-4">
      <h2 class="h5"><%= t("help.sections.#{node.id}") %></h2>
      <p><%= node.message %></p>
      <%= render "chatbots/example", node: %>
    </section>
  <% end %>

  <section class="mb-4">
    <h2 class="h5">Tipos de juego de palabras</h2>
    <div class="row row-cols-1 row-cols-md-2 g-3">
      <% @type_nodes.each do |node| %>
        <div class="col">
          <div class="card h-100">
            <div class="card-body">
              <p class="mb-2"><%= node.message %></p>
              <%= render "chatbots/example", node: %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</div>

<% content_for :title, "Recuperar contraseña" %>

<div class="row justify-content-center">
  <div class="col-12 col-sm-8 col-md-6 col-lg-4">
    <h1 class="h3 mb-3">¿Olvidaste tu contraseña?</h1>

    <%= form_with url: passwords_path do |form| %>
      <div class="mb-3">
        <%= form.label :email_address, "Email", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                             value: params[:email_address], class: "form-control" %>
      </div>
      <%= form.submit "Enviarme las instrucciones", class: "btn btn-primary w-100" %>
    <% end %>

    <p class="mt-3 small"><%= link_to "Volver a ingresar", new_session_path %></p>
  </div>
</div>

<% content_for :title, "Nueva contraseña" %>

<div class="row justify-content-center">
  <div class="col-12 col-sm-8 col-md-6 col-lg-4">
    <h1 class="h3 mb-3">Elegí una contraseña nueva</h1>

    <%= form_with url: password_path(params[:token]), method: :put do |form| %>
      <div class="mb-3">
        <%= form.label :password, "Contraseña nueva", class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
                                class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= form.label :password_confirmation, "Repetila", class: "form-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
                                class: "form-control" %>
      </div>
      <%= form.submit "Guardar", class: "btn btn-primary w-100" %>
    <% end %>
  </div>
</div>

<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · Rubípticos" : "Rubípticos" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rubípticos">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-md bg-primary mb-4" data-bs-theme="dark">
      <div class="container">
        <%= link_to "Rubípticos", root_path, class: "navbar-brand fw-bold" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu-principal"
                aria-controls="menu-principal" aria-expanded="false" aria-label="Abrir menú">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menu-principal">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item"><%= link_to "Jugar", new_game_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Mi racha", streak_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Tabla de posiciones", leaderboard_path, class: "nav-link" %></li>
            <%# Abre el panel del chatbot; sin JavaScript, el href lleva a la página de reglas. %>
            <li class="nav-item">
              <%= link_to "Cómo se juega", help_path, class: "nav-link",
                          data: { bs_toggle: "offcanvas", bs_target: "#chatbot-panel" },
                          aria: { controls: "chatbot-panel" } %>
            </li>
          </ul>
          <%= render "shared/player_menu" %>
          <%= render "shared/theme_toggle" %>
        </div>
      </div>
    </nav>

    <main class="container pb-5">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%# La página del chatbot ya tiene su propio frame "chatbot": ahí no va el panel. %>
    <%= render "shared/chatbot_panel" unless content_for?(:without_chatbot_panel) %>
  </body>
</html>

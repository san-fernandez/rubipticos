<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · Admin" : "Admin" %> · Rubípticos</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg bg-dark mb-4" data-bs-theme="dark">
      <div class="container">
        <%= link_to "Rubípticos · Admin", admin_root_path, class: "navbar-brand" %>
        <% if authenticated? %>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu-admin"
                  aria-controls="menu-admin" aria-expanded="false" aria-label="Abrir menú">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="menu-admin">
            <%# El menú depende del rol, pero el permiso real se controla en cada controlador. %>
            <ul class="navbar-nav me-auto">
              <% if Current.user.admin? %>
                <li class="nav-item"><%= link_to "Crípticos", admin_cryptics_path, class: "nav-link" %></li>
                <li class="nav-item"><%= link_to "Sincronización", admin_syncs_path, class: "nav-link" %></li>
              <% end %>
              <li class="nav-item"><%= link_to "Puntos por tipo", admin_type_scores_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Multiplicadores", admin_difficulty_settings_path, class: "nav-link" %></li>
              <% if Current.user.admin? %>
                <li class="nav-item"><%= link_to "Jugadores", admin_players_path, class: "nav-link" %></li>
                <li class="nav-item"><%= link_to "Usuarios", admin_users_path, class: "nav-link" %></li>
                <li class="nav-item"><%= link_to "Configuración", edit_admin_setting_path, class: "nav-link" %></li>
              <% end %>
            </ul>
            <div class="d-flex align-items-center gap-3">
              <span class="navbar-text small"><%= Current.user.email_address %></span>
              <%= button_to "Salir", session_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
            </div>
          </div>
        <% end %>
      </div>
    </nav>

    <main class="container">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
